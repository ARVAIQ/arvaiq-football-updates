# Release binaries normally belong in GitHub Releases.
# Specific bootstrap release asset folders are explicitly allowed below.
*.exe
*.msi
*.zip
*.sqlite*
*.db
*.env
*.key
*.pem
*.log
__pycache__/

!release-assets/
!release-assets/v2.0.7/
!release-assets/v2.0.7/*.exe
!release-assets/v2.1.0/
!release-assets/v2.1.0/*.exe
!release-assets/admin/
!release-assets/admin/v1.0.0/
!release-assets/admin/v1.0.0/*.exe
!release-assets/v2.1.1/
!release-assets/v2.1.1/*.exe
